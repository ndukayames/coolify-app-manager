# coolify instance origin without /api/v1
COOLIFY_BASE_URL=https://coolify.example.com

# Better Auth: session signing secret and the public URL of this dashboard
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-auth-secret
BETTER_AUTH_URL=http://localhost:3000

# encrypts each tenant's Coolify token in the database (32 bytes)
# generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=your-encryption-key

# SQLite file; in production point this at a persistent volume, e.g. /app/data/app.db
DATABASE_PATH=data/app.db
